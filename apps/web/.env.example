# Supabase Database (from Lovable dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Project (from Lovable dashboard > Settings > API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Storage S3 (from Lovable dashboard > Storage > S3 Access Keys)
SUPABASE_STORAGE_BUCKET=media
SUPABASE_S3_ENDPOINT=https://xxx.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_S3_REGION=auto

# Payload CMS (generate with: openssl rand -hex 16)
PAYLOAD_SECRET=generate-32-char-random-string-here

# AI Models (for agent system - Phase 04)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Firecrawl (for content scraping - Phase 04)
FIRECRAWL_API_KEY=fc-...
