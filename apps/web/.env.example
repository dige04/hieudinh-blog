# Supabase Database
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase (for subscribers table)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Payload CMS (generate with: openssl rand -hex 16)
PAYLOAD_SECRET=your-32-char-secret-here

# Supabase Storage (S3-compatible)
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://[PROJECT_REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto

# Newsletter (Resend)
RESEND_API_KEY=re_...
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Preview Mode (generate with: openssl rand -hex 32)
PREVIEW_SECRET=your-preview-secret-here

# AI Models (for agent system - Phase 04)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Firecrawl (for content scraping - Phase 04)
FIRECRAWL_API_KEY=fc-...
