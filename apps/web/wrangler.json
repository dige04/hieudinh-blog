{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vn-ai-weekly",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "ce083859-07d4-4641-bf3a-6fa49fcbc88d",
      "database_name": "vn-ai-weekly-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "vn-ai-weekly-media"
    }
  ]
}
